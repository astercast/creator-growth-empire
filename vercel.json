{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build.py",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/algorithm-watch",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/functions/health.js": {
      "maxDuration": 10
    },
    "api/functions/changes.js": {
      "maxDuration": 10
    },
    "api/functions/niches.js": {
      "maxDuration": 10
    },
    "api/functions/cron/algorithm-watch.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        }
      ],
      "source": "/data/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": "site",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/cron/algorithm-watch",
      "destination": "/api/functions/cron/algorithm-watch"
    }
  ]
}
