{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Path shape",
  "type": "object",
  "required": [
    "order",
    "stages"
  ],
  "properties": {
    "order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
