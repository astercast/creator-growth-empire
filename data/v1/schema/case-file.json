{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaseFile",
  "type": "object",
  "required": [
    "id",
    "badge",
    "title",
    "path",
    "words",
    "read_minutes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "words": {
      "type": "integer",
      "minimum": 1
    },
    "read_minutes": {
      "type": "integer",
      "minimum": 1
    }
  }
}