{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calculators",
  "type": "object",
  "required": [
    "version",
    "updated",
    "youtube_longform_rpm_bands",
    "niche_growth_2026",
    "platform_rules_2026",
    "sponsorship_rate_card_2026",
    "platform_thresholds",
    "revenue_splits",
    "usage_rights_benchmarks_2026",
    "sponsorship_quoted_prices_2026"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "youtube_longform_rpm_bands": {
      "type": "object",
      "required": [
        "finance_investing",
        "gaming",
        "kids_content"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "niche_growth_2026": {
      "type": "object",
      "required": [
        "date",
        "channel_growth_monthly_pct",
        "search_growth_2026",
        "breakout_formats",
        "rpm_reality"
      ]
    },
    "platform_rules_2026": {
      "type": "object",
      "required": [
        "date",
        "tiktok",
        "youtube_shorts",
        "instagram_reels"
      ]
    },
    "sponsorship_rate_card_2026": {
      "type": "object"
    },
    "sponsorship_quoted_prices_2026": {
      "type": "object",
      "required": [
        "date",
        "note",
        "sources",
        "typical_quoted_by_format",
        "typical_ask_by_followers",
        "instagram_feed_post_modeled",
        "instagram_modeled_basis"
      ],
      "properties": {
        "typical_quoted_by_format": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "quoted_usd",
              "basis",
              "source"
            ],
            "properties": {
              "basis": {
                "type": "string",
                "enum": [
                  "reported"
                ]
              }
            }
          }
        },
        "instagram_feed_post_modeled": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tier",
              "label",
              "range_usd"
            ]
          }
        },
        "instagram_modeled_basis": {
          "type": "string",
          "enum": [
            "modeled"
          ]
        }
      }
    },
    "usage_rights_benchmarks_2026": {
      "type": "object",
      "required": [
        "date",
        "source",
        "note",
        "tiers",
        "whitelisting_per_month_pct"
      ],
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "addon_pct",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "addon_pct": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 2,
                "maxItems": 2
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "whitelisting_per_month_pct": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "platform_thresholds": {
      "type": "object"
    },
    "revenue_splits": {
      "type": "object"
    }
  }
}