{
 "$defs": {
  "change": {
   "anyOf": [
    {
     "required": [
      "source_url"
     ]
    },
    {
     "required": [
      "sources"
     ]
    }
   ],
   "properties": {
    "announced_at": {
     "format": "date-time",
     "type": [
      "string",
      "null"
     ]
    },
    "category": {
     "enum": [
      "algorithm",
      "policy",
      "monetization",
      "legal"
     ],
     "type": "string"
    },
    "confidence": {
     "enum": [
      "verified",
      "single-source"
     ],
     "type": "string"
    },
    "detected_at": {
     "format": "date-time",
     "type": "string"
    },
    "effective_at": {
     "format": "date-time",
     "type": [
      "string",
      "null"
     ]
    },
    "id": {
     "pattern": "^[a-z0-9][a-z0-9-]{2,80}$",
     "type": "string"
    },
    "platform": {
     "enum": [
      "youtube",
      "tiktok",
      "instagram",
      "facebook",
      "x",
      "twitch",
      "kick",
      "other"
     ],
     "type": "string"
    },
    "source_url": {
     "type": "string"
    },
    "sources": {
     "items": {
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "url"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "summary": {
     "maxLength": 1200,
     "minLength": 20,
     "type": "string"
    },
    "title": {
     "maxLength": 160,
     "minLength": 8,
     "type": "string"
    },
    "affects": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "id",
    "platform",
    "title",
    "summary",
    "detected_at",
    "category",
    "confidence"
   ],
   "type": "object"
  }
 },
 "$id": "https://creator-growth-empire.vercel.app/data/v1/schema/changes.json",
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "changes": {
   "items": {
    "$ref": "#/$defs/change"
   },
   "type": "array"
  },
  "confidence_legend": {
   "type": "object"
  },
  "disclaimer": {
   "type": "string"
  },
  "generated_at": {
   "format": "date-time",
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "updated": {
   "type": "string"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "version",
  "updated",
  "generated_at",
  "note",
  "disclaimer",
  "confidence_legend",
  "changes"
 ],
 "title": "Algorithm Watch changes feed (doc)",
 "type": "object"
}
