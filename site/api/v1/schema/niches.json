{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Niches",
  "type": "object",
  "required": [
    "version",
    "updated",
    "note",
    "sources",
    "reality_check",
    "niches",
    "avoid_list"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "growth_context": {
      "type": "string"
    },
    "revenue_tier_legend": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "observed": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reality_check": {
      "type": "object",
      "required": [
        "headline",
        "detail",
        "source"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "niches": {
      "type": "array",
      "items": {
        "$ref": "niche.json"
      }
    },
    "avoid_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "detail",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}