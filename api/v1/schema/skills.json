{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills",
  "type": "object",
  "required": [
    "version",
    "updated",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "skill.json"
      }
    }
  }
}