{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Niches",
  "type": "object",
  "required": [
    "version",
    "updated",
    "note",
    "sources",
    "reality_check",
    "niches",
    "avoid_list"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "growth_context": {
      "type": "string"
    },
    "revenue_tier_legend": {
      "type": "object"
    },
    "stream_fit_legend": {
      "type": "object",
      "description": "Legend for the editorial stream-fit ratings (strong/moderate/weak)."
    },
    "outlook_2027": {
      "type": "object",
      "description": "Doc-level 2027 outlook: summary, platform_signals, evidence_note."
    },
    "breakout_spotlights": {
      "type": "array",
      "description": "Breakout-format spotlights: growth signal, reported rates, competition, why, single_source flag.",
      "items": {
        "type": "object"
      }
    },
    "breakout_format_dossiers": {
      "type": "array",
      "description": "Wave-31 breakout-format dossiers: signal, reported pay range, competition, entry_requirements, who_it_suits, risks, read_2027, sources, single_source flag + source_note.",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reality_check": {
      "type": "object",
      "required": [
        "headline",
        "detail",
        "source"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "niches": {
      "type": "array",
      "items": {
        "$ref": "niche.json"
      }
    },
    "avoid_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "detail",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}